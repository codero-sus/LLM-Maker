def dry_run_report(dataset: Dataset, tokenizer, seq_len: int, collator, goal: str) -> None:
    print("\n--- dry run ---")
    print(f"train rows: {len(dataset):,}")
    count = min(2, len(dataset))
    sample = dataset[:count]
    rows = [{key: values[i] for key, values in sample.items()} for i in range(count)]
    batch = collator(rows)
    print("batch shapes: " + ", ".join(f"{k}={tuple(v.shape)}" for k, v in batch.items()))
    if "labels" in batch:
        total = batch["labels"].numel()
        supervised = int((batch["labels"] != -100).sum())
        print(
            f"supervised tokens: {supervised:,}/{total:,} "
            f"({100 * supervised / max(total, 1):.1f}%) at seq_len={seq_len}"
        )
        print("first row, decoded:")
        print(tokenizer.decode(batch["input_ids"][0][:200], skip_special_tokens=False))
    else:
        print("chosen/rejected token counts (first row):")
        for key in ("chosen_ids", "rejected_ids"):
            length = int((batch[key][0] != tokenizer.pad_token_id).sum())
            print(f"  {key}: {length} tokens -> {tokenizer.decode(batch[key][0][:120])!r}")
    print("\nDry run complete: the data pipeline works. Drop --dry-run to train.\n")


@torch.no_grad()
def sample_outputs(model, tokenizer, prompts: list[str], max_new_tokens: int = 96) -> list[str]:
    model.eval()
    outputs: list[str] = []
    for prompt in prompts:
        messages = [{"role": "user", "content": prompt}]
        if tokenizer.chat_template:
            inputs = tokenizer.apply_chat_template(
                messages, add_generation_prompt=True, return_tensors="pt", return_dict=True
            )
        else:
            inputs = tokenizer(f"User: {prompt}\nAssistant:", return_tensors="pt")
        inputs = {k: v.to(model.device) for k, v in inputs.items()}
        generated = model.generate(
            **inputs, max_new_tokens=max_new_tokens, do_sample=True, temperature=0.7, top_p=0.9
        )
        text = tokenizer.decode(generated[0][inputs["input_ids"].shape[1]:], skip_special_tokens=True)
        outputs.append(text.strip())
        print(f"\n> {prompt}\n{text.strip()}\n")
    model.train()
    return outputs


