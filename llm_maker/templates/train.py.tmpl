class OptimizedTrainer(Trainer):
    """Optimized causal-LM trainer built on the public Hugging Face ``Trainer``.

    It never materialises the full ``[batch, seq, vocab]`` logits.

    At ``seq_len=4096`` and a 128k vocabulary the logits tensor is several
    gigabytes, and ``CrossEntropyLoss`` on it doubles that in fp32.  Projecting
    the hidden states through ``lm_head`` in chunks keeps the peak flat.  If the
    model is wrapped in a way this does not understand, the first step falls
    back to the standard forward pass and says so.
    """

    CHUNK = 512
    MAX_UNWRAP_DEPTH = 5

    def __init__(
        self,
        *args,
        chunked_loss: bool = True,
        compile_backbone: bool = False,
        compile_mode: str = "reduce-overhead",
        **kwargs,
    ):
        super().__init__(*args, **kwargs)
        self._chunked = bool(chunked_loss)
        self._compile_backbone = bool(compile_backbone)
        self._compile_mode = compile_mode
        self._unwrapped: tuple[Any, Any] | None = None

    def _candidates(self) -> list[Any]:
        """Modules that might be the bare transformer backbone, deepest first."""
        found: list[Any] = []
        seen: set[int] = set()
        stack: list[tuple[int, Any]] = [(0, self.model)]
        while stack:
            depth, module = stack.pop(0)
            if id(module) in seen or depth > self.MAX_UNWRAP_DEPTH:
                continue
            seen.add(id(module))
            found.append(module)
            # ``_orig_mod`` is torch.compile's transparent wrapper. Following it
            # keeps the chunked loss path available when compile was requested.
            for name in ("_orig_mod", "model", "base_model"):
                child = getattr(module, name, None)
                if isinstance(child, torch.nn.Module):
                    stack.append((depth + 1, child))
        return list(reversed(found))

    def _resolve(self) -> tuple[Any, Any] | None:
        if self._unwrapped is not None:
            return self._unwrapped
        head = self.model.get_output_embeddings() if hasattr(self.model, "get_output_embeddings") else None
        kwargs = {"output_hidden_states": True}
        for candidate in self._candidates():
            if candidate is head or candidate is self.model:
                continue
            if not hasattr(candidate, "forward"):
                continue
            try:
                with torch.no_grad():
                    probe_ids = torch.zeros((1, 4), dtype=torch.long, device=next(self.model.parameters()).device)
                    out = candidate(input_ids=probe_ids, **kwargs)
                hidden = getattr(out, "last_hidden_state", None)
            except Exception:
                continue
            if hidden is not None:
                backbone = candidate
                if self._compile_backbone:
                    try:
                        # Keep this wrapper only on the trainer. The original
                        # backbone remains attached to the model, so checkpoint
                        # keys are unchanged when Trainer saves the model.
                        backbone = torch.compile(candidate, mode=self._compile_mode, dynamic=True)
                        print(f"torch.compile: transformer backbone is active ({self._compile_mode})")
                    except Exception as exc:  # pragma: no cover - compiler/device-specific
                        print(f"note: torch.compile failed ({exc}); using the optimized eager backbone")
                    self._compile_backbone = False
                self._unwrapped = (backbone, head)
                return self._unwrapped
        return None

    def compute_loss(self, model, inputs, return_outputs=False, **kwargs):  # noqa: D102
        if not self._chunked:
            return super().compute_loss(model, inputs, return_outputs=return_outputs, **kwargs)

        inputs = dict(inputs)
        labels = inputs.pop("labels")
        pair = self._resolve()
        try:
            if pair is None:
                raise RuntimeError("could not isolate the transformer backbone")
            backbone, head = pair
            hidden = backbone(**inputs).last_hidden_state
            if head is None:
                raise RuntimeError("the model exposes no output embedding (lm_head)")
            total = torch.zeros((), device=hidden.device)
            count = 0
            for start in range(0, labels.shape[1], self.CHUNK):
                chunk_labels = labels[:, start:start + self.CHUNK]
                chunk_hidden = hidden[:, start:start + chunk_labels.shape[1]]
                if chunk_labels.numel() == 0 or chunk_hidden.shape[1] == 0:
                    continue
                logits = head(chunk_hidden.reshape(-1, chunk_hidden.shape[-1]))
                total = total + F.cross_entropy(
                    logits.float(), chunk_labels.reshape(-1), ignore_index=-100, reduction="sum"
                )
                count += int((chunk_labels != -100).sum())
            loss = total / max(count, 1)
            return (loss, {"logits": None}) if return_outputs else loss
        except Exception as exc:  # noqa: BLE001 -- never kill a long run over this
            if not getattr(self, "_warned_chunked", False):
                print(f"note: chunked loss unavailable ({exc}); using the standard forward pass")
                self._warned_chunked = True
            self._chunked = False
            return super().compute_loss(
                model, {**inputs, "labels": labels}, return_outputs=return_outputs, **kwargs
            )


# Kept as an alias for notebooks that imported an early generated project.
ChunkedLossTrainer = OptimizedTrainer


class DPOTrainer(Trainer):
    """Direct Preference Optimization (Rafailov et al., 2023).

    loss = -log sigmoid(beta * [(log pi(y_w) - log pi_ref(y_w)) - (log pi(y_l) - log pi_ref(y_l))])

    where each ``log pi`` is the length-normalised sum of token log-probabilities
    over the completion tokens only.
    """

    def __init__(self, *args, beta: float = 0.1, reference_model=None, **kwargs):
        super().__init__(*args, **kwargs)
        self.beta = float(beta)
        self.reference_model = reference_model
        if reference_model is not None:
            self.reference_model.eval()

    @staticmethod
    def _log_prob(logits: torch.Tensor, ids: torch.Tensor, mask: torch.Tensor) -> torch.Tensor:
        """Length-normalised log-probability of the masked (completion) tokens."""
        logits = logits[:, :-1, :]
        ids = ids[:, 1:]
        mask = mask[:, 1:].float()
        log_probs = F.log_softmax(logits.float(), dim=-1)
        token_log_probs = log_probs.gather(2, ids.unsqueeze(-1)).squeeze(-1)
        return (token_log_probs * mask).sum(-1) / mask.sum(-1).clamp(min=1.0)

    def _reference_log_prob(
        self, ids: torch.Tensor, loss_mask: torch.Tensor, attention_mask: torch.Tensor
    ) -> torch.Tensor:
        if self.reference_model is not None:
            # Trainer/Accelerate move the policy, but this separately held
            # reference is not part of its module tree. Place it beside the
            # current batch exactly once on the first DPO forward.
            try:
                reference_device = next(self.reference_model.parameters()).device
                if reference_device != ids.device:
                    self.reference_model.to(ids.device)
            except StopIteration:
                pass
            with torch.no_grad():
                logits = self.reference_model(input_ids=ids, attention_mask=attention_mask).logits
            return self._log_prob(logits, ids, loss_mask)
        if hasattr(self.model, "disable_adapter"):
            with torch.no_grad(), self.model.disable_adapter():
                logits = self.model(input_ids=ids, attention_mask=attention_mask).logits
            return self._log_prob(logits, ids, loss_mask)
        return torch.zeros(ids.shape[0], device=ids.device)

    def compute_loss(self, model, inputs, return_outputs=False, **kwargs):  # noqa: D102
        chosen_ids, chosen_mask = inputs["chosen_ids"], inputs["chosen_mask"]
        rejected_ids, rejected_mask = inputs["rejected_ids"], inputs["rejected_mask"]
        # Older hand-written batches may not carry the attention masks. In that
        # compatibility case preserving the old completion-only mask is safer
        # than guessing a pad token id here.
        chosen_attention = inputs.get("chosen_attention_mask", (chosen_mask > 0).long())
        rejected_attention = inputs.get("rejected_attention_mask", (rejected_mask > 0).long())

        chosen_logits = model(input_ids=chosen_ids, attention_mask=chosen_attention).logits
        rejected_logits = model(input_ids=rejected_ids, attention_mask=rejected_attention).logits

        pi_chosen = self._log_prob(chosen_logits, chosen_ids, chosen_mask)
        pi_rejected = self._log_prob(rejected_logits, rejected_ids, rejected_mask)
        ref_chosen = self._reference_log_prob(chosen_ids, chosen_mask, chosen_attention)
        ref_rejected = self._reference_log_prob(rejected_ids, rejected_mask, rejected_attention)

        delta = (pi_chosen - ref_chosen) - (pi_rejected - ref_rejected)
        loss = -F.logsigmoid(self.beta * delta).mean()
        self._last_accuracy = float((delta > 0).float().mean().detach().cpu())
        return (loss, {"logits": None}) if return_outputs else loss

    def log(self, logs: dict[str, float], *args, **kwargs) -> None:  # noqa: D102
        accuracy = getattr(self, "_last_accuracy", None)
        if accuracy is not None:
            logs["rewards/margin"] = accuracy
        try:
            super().log(logs, *args, **kwargs)
        except TypeError:  # older transformers signatures
            super().log(logs)


def make_training_arguments(
    cfg: dict[str, Any], output_dir: str, profile: TrainerProfile | None = None
) -> TrainingArguments:
    hyp = cfg["hyperparameters"]
    profile = profile or trainer_profile(cfg)
    try:
        tf32_supported = torch.cuda.is_available() and torch.cuda.get_device_capability()[0] >= 8
    except Exception:
        tf32_supported = False
    scheduler = str(hyp.get("lr_scheduler", "cosine"))
    if scheduler not in {
        "linear", "cosine", "cosine_with_restarts", "polynomial", "constant",
        "constant_with_warmup", "inverse_sqrt", "reduce_lr_on_plateau", "cosine_with_min_lr",
    }:
        scheduler = "cosine"

    has_validation = bool(cfg.get("has_validation"))
    save_steps = int(hyp.get("save_steps", 200))
    kwargs: dict[str, Any] = {
        "output_dir": output_dir,
        "overwrite_output_dir": True,
        "per_device_train_batch_size": int(hyp.get("micro_batch_size", 1)),
        "per_device_eval_batch_size": int(hyp.get("micro_batch_size", 1)),
        "gradient_accumulation_steps": int(hyp.get("grad_accum", 8)),
        "learning_rate": float(hyp.get("learning_rate", 2e-4)),
        "num_train_epochs": float(hyp.get("epochs", 1.0)),
        "max_steps": int(hyp["max_steps"]) if hyp.get("max_steps") else -1,
        "lr_scheduler_type": scheduler,
        "warmup_ratio": float(hyp.get("warmup_ratio", 0.03)),
        "weight_decay": float(hyp.get("weight_decay", 0.0)),
        "max_grad_norm": float(hyp.get("grad_clip", 1.0)),
        "gradient_checkpointing": bool(hyp.get("gradient_checkpointing", True)),
        "optim": preferred_optimizer(cfg, profile),
        "bf16": bool(hyp.get("bf16", True)) and torch.cuda.is_bf16_supported(),
        "fp16": (not torch.cuda.is_bf16_supported()) and torch.cuda.is_available(),
        "logging_steps": int(hyp.get("logging_steps", 10)),
        "save_steps": save_steps,
        "save_total_limit": int(hyp.get("save_total_limit", 3)),
        "save_strategy": "steps",
        "report_to": list(cfg.get("reporting") or []),
        "run_name": cfg["project_name"],
        "seed": int(hyp.get("seed", 42)),
        "data_seed": int(hyp.get("seed", 42)),
        "dataloader_num_workers": int(hyp.get("dataloader_num_workers", 2)),
        "dataloader_pin_memory": True,
        "remove_unused_columns": False,
        "ddp_find_unused_parameters": False,
        "tf32": bool(profile.backend == "optimized" and profile.tf32 and tf32_supported),
    }
    if cfg["goal"] == "pretrain":
        kwargs["save_steps"] = max(save_steps, 500)
    if has_validation:
        kwargs["eval_strategy"] = "steps"
        kwargs["eval_steps"] = int(hyp.get("eval_steps", save_steps))
    if hyp.get("gradient_checkpointing", True):
        kwargs["gradient_checkpointing_kwargs"] = {"use_reentrant": False}
    try:
        return TrainingArguments(**kwargs)
    except TypeError:
        # Older transformers: `eval_strategy` used to be `evaluation_strategy`.
        kwargs.pop("eval_strategy", None)
        if has_validation:
            kwargs["evaluation_strategy"] = "steps"
        kwargs.pop("gradient_checkpointing_kwargs", None)
        return TrainingArguments(**kwargs)


