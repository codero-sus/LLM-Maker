def tokenise_everything(cfg: dict[str, Any], parts, tokenizer):
    """Tokenise each dataset with its own column mapping, then mix."""
    goal = cfg["goal"]
    seq_len = int(cfg["hyperparameters"].get("seq_len", 2048))
    tokenised: list[Dataset] = []

    if goal == "dpo":
        for entry, dataset in parts:
            probe = dataset[0]
            fields = detect_fields(probe, entry, goal)
            missing = [k for k in ("chosen", "rejected") if not fields.get(k)]
            if missing:
                raise SystemExit(
                    f"Could not find {missing} in {entry['repo_id']} (columns: {list(probe)}). "
                    "Set datasets[].fields in config.yaml explicitly."
                )
            print(
                f"  {entry['repo_id']}: chosen={fields['chosen']!r} "
                f"rejected={fields['rejected']!r} prompt={fields['prompt']!r}"
            )
            tokenised.append(
                dataset.map(
                    lambda example, fields=fields: tokenise_dpo(example, fields, tokenizer, seq_len),
                    remove_columns=dataset.column_names,
                    desc=f"tokenising {entry['repo_id']}",
                )
            )
        return mix_datasets(cfg, tokenised)

    for entry, dataset in parts:
        probe = dataset[0]
        fields = detect_fields(probe, entry, goal)
        if goal in ("cpt", "pretrain"):
            print(f"  {entry['repo_id']}: text={fields['text']!r}")
        else:
            print(
                f"  {entry['repo_id']}: messages={fields['messages']!r} "
                f"prompt={fields['prompt']!r} completion={fields['completion']!r} "
                f"text={fields['text']!r}"
            )
        mapping = make_sft_tokeniser(cfg, fields, tokenizer, seq_len)
        encoded = dataset.map(mapping, remove_columns=dataset.column_names,
                              desc=f"tokenising {entry['repo_id']}")
        tokenised.append(encoded)

    mixed = mix_datasets(cfg, tokenised)
    if (cfg["hyperparameters"].get("packing", True)) and goal in ("cpt", "pretrain"):
        mixed = pack_sequences(mixed, tokenizer, seq_len, tokenizer.eos_token_id)
    return mixed


def main(argv: list[str] | None = None) -> int:
    ns = parse_args(argv)
    cfg = build_settings(ns)
    goal, method = cfg["goal"], cfg["method"]
    hyp = cfg["hyperparameters"]
    seq_len = int(hyp.get("seq_len", 2048))
    output_dir = cfg.get("output_dir") or f"out/{cfg['project_name']}"

    print("=" * 72)
    print(f"project    : {cfg['project_name']}")
    print(f"goal       : {goal}")
    print(f"method     : {method}")
    print(f"base model : {cfg['model'].get('base_model') or '(from scratch)'}")
    print(f"datasets   : {', '.join(e['repo_id'] for e in cfg['datasets'])}")
    print(f"output     : {output_dir}")
    print("=" * 72)

    set_seed(int(hyp.get("seed", 42)))
    random.seed(int(hyp.get("seed", 42)))
    np.random.seed(int(hyp.get("seed", 42)))

    token = os.environ.get("HF_TOKEN")
    tokenizer = load_tokenizer(cfg)

    print("loading datasets:")
    parts, validations = load_raw_parts(cfg, token)
    for entry, dataset in parts:
        describe(dataset, entry["repo_id"])
    cfg["has_validation"] = bool(validations)

    print("tokenising:")
    train_dataset = tokenise_everything(cfg, parts, tokenizer)
    if validations:
        validation_datasets = []
        for (entry, _), validation in zip(parts, validations):
            fields = detect_fields(validation[0], entry, goal)
            mapping = (
                (lambda example, f=fields: tokenise_dpo(example, f, tokenizer, seq_len))
                if goal == "dpo"
                else make_sft_tokeniser(cfg, fields, tokenizer, seq_len)
            )
            validation_datasets.append(
                validation.map(mapping, remove_columns=validation.column_names, desc="tokenising validation")
            )
        eval_dataset = mix_datasets(cfg, validation_datasets)
    else:
        eval_dataset = None
        print("note: no validation split; add `val_ratio: 0.02` to a dataset in config.yaml to get one")

    collator = (
        DPOCollator(pad_token_id=tokenizer.pad_token_id, max_length=seq_len)
        if goal == "dpo"
        else SFTDataCollator(
            pad_token_id=tokenizer.pad_token_id,
            max_length=seq_len if hyp.get("packing", True) and goal in ("cpt", "pretrain") else None,
        )
    )

    profile = configure_performance_runtime(cfg)
    model, quant_config = build_model(cfg)

    if cfg.get("dry_run"):
        dry_run_report(train_dataset, tokenizer, seq_len, collator, goal)
        return 0

    if method in ("lora", "qlora"):
        model = apply_lora(cfg, model, quant_config)
    if hyp.get("gradient_checkpointing", True) and hasattr(model, "enable_input_require_grads"):
        model.enable_input_require_grads()

    model, is_compiled = maybe_compile_model(cfg, model, profile)
    reference_model = build_reference_model(cfg, tokenizer) if goal == "dpo" else None

    training_args = make_training_arguments(cfg, output_dir, profile)
    world = max(1, int(os.environ.get("WORLD_SIZE", "1")))
    local = max(1, int(os.environ.get("LOCAL_RANK", "0")) + 1)
    devices = torch.cuda.device_count() or 1
    global_batch = (
        training_args.per_device_train_batch_size
        * training_args.gradient_accumulation_steps
        * world
    )
    if local == 1:
        print(
            f"global batch: {global_batch} sequences = {global_batch * seq_len:,} tokens/step "
            f"({devices} visible GPU(s))"
        )

    trainer_kwargs: dict[str, Any] = {
        "model": model,
        "args": training_args,
        "train_dataset": train_dataset,
        "eval_dataset": eval_dataset,
        "data_collator": collator,
    }
    if goal == "dpo":
        # DPO needs a preference objective rather than Trainer's causal-LM
        # objective. It retains all data/attention correctness fixes in both
        # profiles; compile is deliberately skipped above for this two-policy loss.
        trainer = DPOTrainer(
            beta=float(hyp.get("dpo_beta", 0.1)), reference_model=reference_model, **trainer_kwargs
        )
    elif profile.backend == "optimized":
        trainer = OptimizedTrainer(
            chunked_loss=bool(cfg.get("chunked_loss", True)),
            compile_backbone=is_compiled,
            compile_mode=profile.compile_mode,
            **trainer_kwargs,
        )
    else:
        trainer = Trainer(**trainer_kwargs)

    started = time.time()
    trainer.train(resume_from_checkpoint=cfg.get("resume_from_checkpoint"))
    elapsed = time.time() - started

    # The optimized trainer keeps the compiled backbone as a private runtime
    # wrapper, but also unwrap a user-supplied compiled model defensively so the
    # saved checkpoint has ordinary Transformers parameter names.
    if is_compiled:
        trainer.model = unwrap_compiled_model(trainer.model)
        model = trainer.model
    trainer.save_model(output_dir)
    tokenizer.save_pretrained(output_dir)
    steps = int(trainer.state.global_step)
    summary = {
        "goal": goal,
        "method": method,
        "steps": steps,
        "wall_clock_seconds": round(elapsed, 1),
        "tokens_seen_estimate": steps * global_batch * seq_len,
        "final_metrics": {
            key: value
            for key, value in (trainer.state.log_history[-1] if trainer.state.log_history else {}).items()
            if isinstance(value, (int, float))
        },
    }
    Path(output_dir).mkdir(parents=True, exist_ok=True)
    (Path(output_dir) / "training_summary.json").write_text(
        json.dumps(summary, indent=2), encoding="utf-8"
    )
    print("\ntraining summary:\n" + json.dumps(summary, indent=2))

    prompts_file = Path(cfg.get("prompts_file") or "prompts.jsonl")
    if ns.smoke_test and prompts_file.exists():
        prompts = [
            json.loads(line)["prompt"]
            for line in prompts_file.read_text(encoding="utf-8").splitlines()
            if line.strip()
        ]
        sample_outputs(model, tokenizer, prompts[:3])
    return 0


if __name__ == "__main__":
    sys.exit(main())
