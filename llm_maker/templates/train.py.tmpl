# ==========================================================================
# configuration
# ==========================================================================
def load_config(path: str | Path) -> dict[str, Any]:
    path = Path(path)
    text = path.read_text(encoding="utf-8")
    if path.suffix in (".yaml", ".yml"):
        if yaml is None:
            raise SystemExit("PyYAML is required for config.yaml -- pip install pyyaml")
        return yaml.safe_load(text)
    return json.loads(text)


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--config", default="config.yaml", help="path to config.yaml (or .json)")
    parser.add_argument("--output-dir", default=None, help="override the output directory")
    parser.add_argument("--dry-run", action="store_true", help="build the data pipeline and exit")
    parser.add_argument("--smoke-test", action="store_true", help="run 20 steps then sample text")
    parser.add_argument("--learning-rate", type=float, default=None)
    parser.add_argument("--epochs", type=float, default=None)
    parser.add_argument("--max-steps", type=int, default=None)
    parser.add_argument("--seq-len", type=int, default=None)
    parser.add_argument("--micro-batch", type=int, default=None)
    parser.add_argument("--grad-accum", type=int, default=None)
    parser.add_argument("--method", default=None, choices=["lora", "qlora", "full", "from-scratch"])
    parser.add_argument("--mask-prompt", action="store_true", help="SFT: train only on the answer")
    parser.add_argument("--no-packing", action="store_true", help="disable sequence packing")
    parser.add_argument("--no-flash-attn", action="store_true", help="use sdpa/eager attention")
    parser.add_argument(
        "--trainer", choices=["optimized", "standard"], default=None,
        help="override config trainer profile; optimized uses chunked loss and safe CUDA fast paths",
    )
    parser.add_argument(
        "--torch-compile", action="store_true",
        help="opt in to torch.compile (single-GPU full/LoRA SFT or CPT only)",
    )
    parser.add_argument("--no-tf32", action="store_true", help="disable CUDA TF32 matmul acceleration")
    parser.add_argument("--max-train-samples", type=int, default=None, help="cap rows per dataset")
    parser.add_argument("--resume", default=None, help="checkpoint directory to resume from")
    return parser.parse_args(argv)


def build_settings(ns: argparse.Namespace) -> dict[str, Any]:
    cfg = load_config(ns.config)
    hyp = cfg.setdefault("hyperparameters", {})
    overrides = {
        "learning_rate": ns.learning_rate,
        "epochs": ns.epochs,
        "max_steps": ns.max_steps,
        "seq_len": ns.seq_len,
        "micro_batch_size": ns.micro_batch,
        "grad_accum": ns.grad_accum,
    }
    for key, value in overrides.items():
        if value is not None:
            hyp[key] = value
    if ns.method:
        cfg["method"] = ns.method
    if ns.mask_prompt:
        hyp["mask_prompt"] = True
    if ns.no_packing:
        hyp["packing"] = False
    if ns.no_flash_attn:
        hyp["flash_attention"] = False
    trainer = cfg.setdefault("trainer", {})
    if ns.trainer:
        trainer["backend"] = ns.trainer
    if ns.torch_compile:
        trainer["torch_compile"] = True
    if ns.no_tf32:
        trainer["tf32"] = False
    if ns.output_dir:
        cfg["output_dir"] = ns.output_dir
    if ns.max_train_samples:
        cfg.setdefault("limits", {})["max_train_samples"] = ns.max_train_samples
    if ns.smoke_test:
        hyp["max_steps"] = min(int(hyp.get("max_steps") or 20), 20)
        cfg["output_dir"] = f"{cfg.get('output_dir', 'out')}-smoke"
    if ns.dry_run:
        cfg["dry_run"] = True
    if ns.resume:
        cfg["resume_from_checkpoint"] = ns.resume
    return cfg


# ==========================================================================
# loading the dataset mixture
# ==========================================================================
def load_dataset_entry(entry: dict[str, Any], token: str | None) -> Dataset:
    """Load one dataset from the Hub, tolerating the datasets 2.x/3.x keyword split."""
    kwargs: dict[str, Any] = {"path": entry["repo_id"], "split": entry.get("split") or "train"}
    if entry.get("config"):
        kwargs["name"] = entry["config"]
    try:
        loaded = load_dataset(token=token, **kwargs)
    except TypeError:
        loaded = load_dataset(use_auth_token=token, **kwargs)

    if isinstance(loaded, DatasetDict):
        split = entry.get("split")
        if split in loaded:
            loaded = loaded[split]
        elif "train" in loaded:
            loaded = loaded["train"]
        else:
            loaded = loaded[list(loaded.keys())[0]]
    return loaded


def load_raw_parts(
    cfg: dict[str, Any], token: str | None
) -> tuple[list[tuple[dict[str, Any], Dataset]], list[Dataset]]:
    """Load every dataset separately so each keeps its own column mapping."""
    parts: list[tuple[dict[str, Any], Dataset]] = []
    validations: list[Dataset] = []
    limit = int((cfg.get("limits") or {}).get("max_train_samples") or 0)

    for entry in cfg["datasets"]:
        dataset = load_dataset_entry(entry, token)
        if limit and len(dataset) > limit:
            dataset = dataset.select(range(limit))
        val_ratio = entry.get("val_ratio")
        if val_ratio:
            split = dataset.train_test_split(test_size=float(val_ratio), seed=42)
            dataset, validation = split["train"], split["test"]
            validations.append(validation)
        parts.append((entry, dataset))
    return parts, validations


def mix_datasets(cfg: dict[str, Any], datasets: list[Dataset]) -> Dataset:
    """Combine tokenised datasets according to the mixture strategy."""
    if len(datasets) == 1:
        return datasets[0]
    strategy = (cfg.get("mixture") or {}).get("strategy", "weighted")
    if strategy != "weighted":
        return concatenate_datasets(datasets)

    weights = [float(e.get("weight", 1.0)) for e in cfg["datasets"]][: len(datasets)]
    total = sum(weights) or 1.0
    probabilities = [w / total for w in weights]
    return interleave_datasets(
        datasets,
        probabilities=probabilities,
        seed=int((cfg.get("hyperparameters") or {}).get("seed", 42)),
        stopping_strategy="all_exhausted",
    )


def describe(dataset: Dataset, name: str) -> None:
    print(f"  {name}: {len(dataset):,} rows, columns = {list(dataset.features)}")


def find_column(columns: Iterable[str], patterns: Iterable[str]) -> str | None:
    """First exact (case-insensitive) match, then first substring match."""
    lowered = {c.lower(): c for c in columns}
    for pattern in patterns:
        if pattern in lowered:
            return lowered[pattern]
    for pattern in patterns:
        for col_lower, col in lowered.items():
            if pattern in col_lower:
                return col
    return None


def detect_fields(example: dict[str, Any], entry: dict[str, Any], goal: str) -> dict[str, str | None]:
    """Resolve the column names for one dataset, preferring what config.yaml says."""
    configured = {
        "prompt": entry.get("fields", {}).get("prompt_field"),
        "completion": entry.get("fields", {}).get("completion_field"),
        "messages": entry.get("fields", {}).get("messages_field"),
        "text": entry.get("fields", {}).get("text_field"),
        "chosen": entry.get("fields", {}).get("chosen_field"),
        "rejected": entry.get("fields", {}).get("rejected_field"),
    }
    columns = list(example.keys())

    if goal == "dpo":
        configured["chosen"] = configured["chosen"] or find_column(
            columns, ("chosen", "chosen_response", "preferred", "response_a", "answer_a")
        )
        configured["rejected"] = configured["rejected"] or find_column(
            columns, ("rejected", "rejected_response", "dispreferred", "response_b", "answer_b")
        )
    configured["prompt"] = configured["prompt"] or find_column(
        columns, ("prompt", "instruction", "question", "input", "query", "problem", "history")
    )
    if configured["messages"] is None:
        configured["messages"] = find_column(columns, ("messages", "conversations", "conversation"))
    if configured["text"] is None:
        configured["text"] = find_column(columns, ("text", "content", "document", "article", "body"))
    if configured["completion"] is None:
        configured["completion"] = find_column(
            columns, ("completion", "output", "response", "answer", "solution", "summary", "highlights")
        )
    return configured


def normalise_messages(value: Any) -> list[dict[str, str]]:
    """Accept ShareGPT-style lists of dicts, or a single string."""
    if isinstance(value, str):
        return [{"role": "user", "content": value}]
    messages: list[dict[str, str]] = []
    for turn in value or []:
        if not isinstance(turn, dict):
            continue
        role = str(turn.get("role") or turn.get("from") or "user")
        role = {"human": "user", "gpt": "assistant"}.get(role, role)
        content = turn.get("content") or turn.get("value") or turn.get("text") or ""
        if content:
            messages.append({"role": role, "content": str(content)})
    return messages


def as_text(value: Any) -> str:
    if isinstance(value, str):
        return value
    if isinstance(value, (list, tuple)) and value:
        return as_text(value[0])  # e.g. SQuAD's list of answers
    if isinstance(value, dict):
        return as_text(value.get("text") or value.get("value") or "")
    return "" if value is None else str(value)


def chat_ids(
    tokenizer,
    messages: list[dict[str, str]],
    *,
    add_generation_prompt: bool = False,
    max_len: int | None = None,
) -> list[int]:
    """Render chat messages and return a *plain list* of token ids.

    This exists because the return type of ``apply_chat_template(tokenize=True)``
    changed: transformers 4.x returns a list of ids, transformers 5.x returns a
    ``BatchEncoding`` dict by default. ``list(dict)`` would silently yield the
    string ``"input_ids"`` as training data, so the result is normalised here
    instead of trusting the default.
    """
    if not messages:
        # Reachable when masking the prompt of a sample whose first turn is the
        # assistant's -- transformers raises on an empty conversation.
        return []
    kwargs: dict[str, Any] = {"tokenize": True, "add_generation_prompt": add_generation_prompt}
    if max_len:
        kwargs["truncation"] = True
        kwargs["max_length"] = max_len
    try:
        rendered = tokenizer.apply_chat_template(messages, return_dict=False, **kwargs)
    except TypeError:
        rendered = tokenizer.apply_chat_template(messages, **kwargs)

    if isinstance(rendered, dict):
        rendered = rendered["input_ids"]
    elif hasattr(rendered, "get") and "input_ids" in rendered:
        rendered = rendered["input_ids"]
    if len(rendered) and not isinstance(rendered[0], int):
        rendered = rendered[0]  # a batch of one
    return [int(token) for token in rendered]


def build_text_and_messages(
    example: dict[str, Any],
    fields: dict[str, str | None],
    tokenizer,
    goal: str,
) -> tuple[str | None, list[dict[str, str]]]:
    """Return ``(plain_text, chat_messages)`` for one raw row."""
    messages_field = fields.get("messages")
    if messages_field and example.get(messages_field):
        messages = normalise_messages(example[messages_field])
        if messages:
            text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=False)
            return text, messages

    prompt_field, completion_field = fields.get("prompt"), fields.get("completion")
    if goal in ("cpt", "pretrain") or not completion_field:
        for key in (fields.get("text"), prompt_field, completion_field):
            if key and example.get(key):
                return as_text(example[key]), []
        # Last resort: every string field in the row, in column order.
        joined = "\n\n".join(as_text(v) for v in example.values() if isinstance(v, str) and v.strip())
        return joined, []

    prompt = as_text(example.get(prompt_field) if prompt_field else "").strip()
    answer = as_text(example.get(completion_field)).strip()
    extra = example.get("input")
    if isinstance(extra, str) and extra and "{input}" not in prompt and extra not in prompt:
        prompt = f"{prompt}\n\n{extra}"
    messages = [{"role": "user", "content": prompt}, {"role": "assistant", "content": answer}]
    text = tokenizer.apply_chat_template(messages, tokenize=False, add_generation_prompt=False)
    return text, messages


# ==========================================================================
# tokenisation
# ==========================================================================
def make_sft_tokeniser(
    cfg: dict[str, Any],
    fields: dict[str, str | None],
    tokenizer,
    max_len: int,
) -> Callable[[dict[str, Any]], dict[str, Any]]:
    """Build the row -> ``input_ids``/``labels`` mapping used for SFT and CPT."""
    mask_prompt = bool((cfg.get("hyperparameters") or {}).get("mask_prompt"))
    goal = cfg["goal"]

    def tokenise(example: dict[str, Any]) -> dict[str, Any]:
        _, messages = build_text_and_messages(example, fields, tokenizer, goal)
        if not messages:
            text, _ = build_text_and_messages(example, fields, tokenizer, goal)
            encoded = tokenizer(
                text or "", truncation=True, max_length=max_len, add_special_tokens=True
            )
            ids = encoded["input_ids"]
            return {"input_ids": ids, "labels": list(ids)}

        ids = chat_ids(tokenizer, messages, max_len=max_len)
        labels = list(ids)
        if mask_prompt and messages[-1]["role"] == "assistant":
            prompt_ids = chat_ids(
                tokenizer, messages[:-1], add_generation_prompt=True, max_len=max_len
            )
            boundary = min(len(prompt_ids), len(labels))
            labels[:boundary] = [-100] * boundary
        return {"input_ids": ids, "labels": labels}

    return tokenise


def pack_sequences(dataset: Dataset, tokenizer, seq_len: int, eos_id: int | None) -> Dataset:
    """Concatenate documents into fixed ``seq_len`` blocks (no padding wasted)."""

    def group(batch: dict[str, list[list[int]]]) -> dict[str, list[list[int]]]:
        buffer: list[int] = []
        input_ids: list[list[int]] = []
        labels: list[list[int]] = []
        attention: list[list[int]] = []
        for ids in batch["input_ids"]:
            buffer.extend(list(ids))
            if eos_id is not None:
                buffer.append(eos_id)
            while len(buffer) >= seq_len:
                chunk = buffer[:seq_len]
                buffer = buffer[seq_len:]
                input_ids.append(chunk)
                labels.append(list(chunk))
                attention.append([1] * seq_len)
        return {"input_ids": input_ids, "labels": labels, "attention_mask": attention}

    return dataset.map(
        group, batched=True, batch_size=1000, remove_columns=dataset.column_names,
        desc="packing sequences",
    )


def longest_common_prefix(a: str, b: str) -> str:
    """Character-level common prefix, trimmed back to the last line break."""
    limit = min(len(a), len(b))
    index = 0
    while index < limit and a[index] == b[index]:
        index += 1
    prefix = a[:index]
    cut = max(prefix.rfind("\n"), prefix.rfind(". "))
    return prefix[: cut + 1] if cut > 0 else ""


def tokenise_dpo(
    example: dict[str, Any],
    fields: dict[str, str | None],
    tokenizer,
    max_len: int,
) -> dict[str, Any]:
    """Tokenise one preference pair into prompt / chosen / rejected ids.

    The prompt is whatever `prompt_field` holds.  Many preference datasets
    (Anthropic's HH-RLHF, for instance) ship full transcripts instead, so when
    there is no prompt column we take the longest common prefix of the two
    responses as the shared prompt and keep only the differing tails as the
    completions.
    """
    prompt_field = fields.get("prompt")
    chosen_field, rejected_field = fields.get("chosen"), fields.get("rejected")
    prompt = as_text(example.get(prompt_field) if prompt_field else "").strip()
    chosen = as_text(example.get(chosen_field) if chosen_field else "")
    rejected = as_text(example.get(rejected_field) if rejected_field else "")

    if not prompt and chosen and rejected:
        prefix = longest_common_prefix(chosen, rejected)
        if len(prefix) > 20:
            prompt = prefix.strip()
            chosen, rejected = chosen[len(prefix):], rejected[len(prefix):]

    prompt_messages = [{"role": "user", "content": prompt}] if prompt else []
    prompt_ids = (
        chat_ids(tokenizer, prompt_messages, add_generation_prompt=True, max_len=max_len)
        if prompt_messages
        else []
    )

    def completion_ids(text: str) -> list[int]:
        ids = tokenizer(text, add_special_tokens=False, truncation=True, max_length=max_len)["input_ids"]
        if tokenizer.eos_token_id is not None:
            ids = ids + [tokenizer.eos_token_id]
        return ids or [tokenizer.eos_token_id or 0]

    return {
        "prompt_ids": prompt_ids,
        "chosen_ids": completion_ids(chosen.strip()),
        "rejected_ids": completion_ids(rejected.strip()),
    }


@dataclass
class SFTDataCollator:
    """Right-pads ``input_ids``/``labels`` (``-100`` for padding)."""

    pad_token_id: int
    max_length: int | None = None

    def __call__(self, features: list[dict[str, Any]]) -> dict[str, torch.Tensor]:
        lengths = [len(f["input_ids"]) for f in features]
        target = self.max_length or max(lengths)
        target = min(target, max(lengths)) if self.max_length else target
        target = max(target, 1)

        input_ids, labels, masks = [], [], []
        for feature in features:
            ids = list(feature["input_ids"])[:target]
            lbls = list(feature.get("labels", feature["input_ids"]))[:target]
            pad = target - len(ids)
            input_ids.append(ids + [self.pad_token_id] * pad)
            labels.append(lbls + [-100] * pad)
            masks.append([1] * len(ids) + [0] * pad)
        return {
            "input_ids": torch.tensor(input_ids, dtype=torch.long),
            "labels": torch.tensor(labels, dtype=torch.long),
            "attention_mask": torch.tensor(masks, dtype=torch.long),
        }


@dataclass
class DPOCollator:
    """Pad DPO pairs while keeping attention and loss masks separate.

    ``*_mask`` marks only completion tokens, which are the terms DPO scores.
    ``*_attention_mask`` includes both prompt and completion tokens, so the
    policy can actually attend to the instruction while producing the answer.
    """

    pad_token_id: int
    max_length: int | None = None

    def __call__(self, features: list[dict[str, Any]]) -> dict[str, torch.Tensor]:
        def build(completion_key: str, target: int) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
            rows, loss_masks, attention_masks = [], [], []
            for feature in features:
                prompt = list(feature["prompt_ids"])
                completion = list(feature[completion_key])
                # Always reserve one position for a scored completion token.
                prompt = prompt[-max(target - 1, 0):]
                completion = completion[:max(target - len(prompt), 1)]
                ids = prompt + completion
                loss_mask = [0] * len(prompt) + [1] * len(completion)
                pad = target - len(ids)
                rows.append(ids + [self.pad_token_id] * pad)
                loss_masks.append(loss_mask + [0] * pad)
                attention_masks.append([1] * len(ids) + [0] * pad)
            return (
                torch.tensor(rows, dtype=torch.long),
                torch.tensor(loss_masks, dtype=torch.long),
                torch.tensor(attention_masks, dtype=torch.long),
            )

        max_chosen = max(len(f["prompt_ids"]) + len(f["chosen_ids"]) for f in features)
        max_rejected = max(len(f["prompt_ids"]) + len(f["rejected_ids"]) for f in features)
        if self.max_length:
            max_chosen = min(max_chosen, self.max_length)
            max_rejected = min(max_rejected, self.max_length)
        chosen_ids, chosen_mask, chosen_attention_mask = build("chosen_ids", max(max_chosen, 1))
        rejected_ids, rejected_mask, rejected_attention_mask = build("rejected_ids", max(max_rejected, 1))
        return {
            "chosen_ids": chosen_ids,
            "chosen_mask": chosen_mask,
            "chosen_attention_mask": chosen_attention_mask,
            "rejected_ids": rejected_ids,
            "rejected_mask": rejected_mask,
            "rejected_attention_mask": rejected_attention_mask,
        }


# ==========================================================================
# model construction
# ==========================================================================
def load_tokenizer(cfg: dict[str, Any]):
    model_id = cfg["model"].get("tokenizer") or cfg["model"]["base_model"]
    tokenizer = AutoTokenizer.from_pretrained(model_id, use_fast=True)
    if tokenizer.pad_token is None:
        tokenizer.pad_token = tokenizer.eos_token or tokenizer.unk_token
    tokenizer.padding_side = "right"
    if tokenizer.chat_template is None:
        print("note: the tokenizer has no chat template; falling back to a plain prompt/answer format")
    return tokenizer


def attention_implementation(cfg: dict[str, Any]) -> str:
    if not (cfg.get("hyperparameters") or {}).get("flash_attention", True):
        return "eager"
    try:
        __import__("flash_attn")
        return "flash_attention_2"
    except Exception:
        print("note: flash-attn is not installed; using sdpa (install flash-attn for faster steps)")
        return "sdpa"


@dataclass(frozen=True)
class TrainerProfile:
    """Runtime-only switches for the generated trainer.

    Keeping these separate from the batch/sequence hyperparameters makes the
    plan reproducible: turning a fast path on or off does not quietly change
    the estimated token budget.
    """

    backend: str = "optimized"
    torch_compile: bool = False
    compile_mode: str = "reduce-overhead"
    tf32: bool = True


def trainer_profile(cfg: dict[str, Any]) -> TrainerProfile:
    raw = cfg.get("trainer") or {}
    backend = str(raw.get("backend", "optimized")).lower().strip()
    compile_mode = str(raw.get("compile_mode", "reduce-overhead")).lower().strip()
    if backend not in {"optimized", "standard"}:
        raise SystemExit("config trainer.backend must be 'optimized' or 'standard'")
    if compile_mode not in {"default", "reduce-overhead", "max-autotune"}:
        raise SystemExit("config trainer.compile_mode must be default, reduce-overhead or max-autotune")
    return TrainerProfile(
        backend=backend,
        torch_compile=bool(raw.get("torch_compile", False)),
        compile_mode=compile_mode,
        tf32=bool(raw.get("tf32", True)),
    )


def configure_performance_runtime(cfg: dict[str, Any]) -> TrainerProfile:
    """Enable only CUDA speedups that preserve the training objective.

    TF32 affects fp32 matrix-multiply precision only; model weights, gradients
    and the bf16/fp16 autocast choice are unchanged. Fused AdamW is chosen later
    only when the installed CUDA build advertises a suitable accelerator.
    """
    profile = trainer_profile(cfg)
    if profile.backend == "standard":
        print("trainer    : standard Hugging Face Trainer (optimized fast paths disabled)")
        return profile

    if not torch.cuda.is_available():
        print("trainer    : optimized profile (CUDA is unavailable; using portable fallbacks)")
        return profile

    tf32_on = False
    if profile.tf32:
        try:
            major, _minor = torch.cuda.get_device_capability()
            if major >= 8:  # TF32 starts with NVIDIA Ampere
                torch.backends.cuda.matmul.allow_tf32 = True
                torch.backends.cudnn.allow_tf32 = True
                if hasattr(torch, "set_float32_matmul_precision"):
                    torch.set_float32_matmul_precision("high")
                tf32_on = True
        except Exception as exc:  # pragma: no cover - device-specific
            print(f"note: could not enable TF32 ({exc}); continuing without it")
    print(
        "trainer    : optimized Hugging Face Trainer "
        f"(chunked loss, TF32={'on' if tf32_on else 'off'}, "
        f"torch.compile={'requested' if profile.torch_compile else 'off'})"
    )
    return profile


def preferred_optimizer(cfg: dict[str, Any], profile: TrainerProfile) -> str:
    """Choose fused AdamW only when it is both safe and useful.

    QLoRA's paged/8-bit optimizer and any explicit non-AdamW selection are
    preserved exactly. This is intentionally a runtime check: a generated
    project may be moved from a laptop to a GPU box after it is created.
    """
    requested = str((cfg.get("hyperparameters") or {}).get("optimizer") or "adamw_torch")
    try:
        major, _minor = torch.cuda.get_device_capability()
        fused_available = torch.cuda.is_available() and major >= 7
    except Exception:
        fused_available = False
    # A planner-generated full/pretraining config may name the fused variant,
    # then later be run on CPU for a tiny smoke test. Never let that turn an
    # otherwise useful dry run into an optimizer-construction error.
    if requested == "adamw_torch_fused" and not fused_available:
        print("note: fused AdamW needs a supported CUDA GPU; falling back to adamw_torch")
        return "adamw_torch"
    if profile.backend == "optimized" and requested == "adamw_torch" and fused_available:
        return "adamw_torch_fused"
    return requested


def maybe_compile_model(cfg: dict[str, Any], model, profile: TrainerProfile):
    """Apply ``torch.compile`` only for combinations known to serialize cleanly.

    Quantized bitsandbytes modules, DPO's two-policy loss, and distributed or
    ZeRO launches have their own graph/runtime hooks. They remain on the
    optimized eager path rather than risking a slow first-step failure.
    """
    if not profile.torch_compile:
        return model, False
    if profile.backend != "optimized":
        print("note: --torch-compile ignored by the standard trainer profile")
        return model, False
    world = int(os.environ.get("WORLD_SIZE", "1"))
    method, goal = cfg.get("method"), cfg.get("goal")
    if method == "qlora" or goal == "dpo" or world > 1 or int(cfg.get("zero_stage") or 0) > 0:
        print(
            "note: torch.compile is skipped for QLoRA, DPO, or distributed/ZeRO launches; "
            "the optimized eager path remains enabled"
        )
        return model, False
    if not hasattr(torch, "compile"):
        print("note: torch.compile needs PyTorch 2.0+; using the optimized eager path")
        return model, False
    # OptimizedTrainer compiles its *backbone* on the first batch, not the
    # CausalLM wrapper. That retains chunked logits (the main VRAM saving) and
    # leaves the model's state_dict pristine for normal save_pretrained output.
    print(f"torch.compile: requested for the transformer backbone (mode={profile.compile_mode!r}, dynamic=True)")
    return model, True


def unwrap_compiled_model(model):
    """Get an exportable module back from a user-supplied compile wrapper."""
    return getattr(model, "_orig_mod", model)


def build_model(cfg: dict[str, Any], *, use_cache: bool = False):
    """Build the model. Returns ``(model, quantization_config)``."""
    goal, method = cfg["goal"], cfg["method"]
    model_cfg = cfg["model"]
    token = os.environ.get("HF_TOKEN")
    dtype = torch.bfloat16 if cfg["hyperparameters"].get("bf16", True) else torch.float16
    attn = attention_implementation(cfg)

    if goal == "pretrain" or method == "from-scratch":
        config = AutoConfig.for_model(
            "llama",
            vocab_size=int(model_cfg["vocab_size"]),
            hidden_size=int(model_cfg["d_model"]),
            intermediate_size=int(round(model_cfg["d_model"] * 8 / 3 / 256) * 256),
            num_hidden_layers=int(model_cfg["n_layer"]),
            num_attention_heads=int(model_cfg["n_head"]),
            num_key_value_heads=int(model_cfg["n_kv_head"]),
            max_position_embeddings=int(model_cfg["max_seq_len"]),
            rope_theta=float(model_cfg.get("rope_theta", 10_000.0)),
            tie_word_embeddings=bool(model_cfg.get("tie_embeddings", False)),
            attention_dropout=0.0,
            use_cache=use_cache,
        )
        model = AutoModelForCausalLM.from_config(config)
        total = sum(p.numel() for p in model.parameters())
        print(f"initialised a fresh model with {total / 1e9:.3f}B parameters")
        return model, None

    quant_config = None
    if method == "qlora":
        from transformers import BitsAndBytesConfig

        quant_config = BitsAndBytesConfig(
            load_in_4bit=True,
            bnb_4bit_quant_type="nf4",
            bnb_4bit_use_double_quant=True,
            bnb_4bit_compute_dtype=dtype,
        )
    model = AutoModelForCausalLM.from_pretrained(
        model_cfg["base_model"],
        quantization_config=quant_config,
        torch_dtype=dtype,
        attn_implementation=attn,
        token=token,
        device_map={"": 0} if quant_config is not None else None,
        use_cache=use_cache,
    )
    model.config.use_cache = use_cache
    return model, quant_config


def apply_lora(cfg: dict[str, Any], model, quant_config):
    from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training

    hyp = cfg["hyperparameters"]
    if quant_config is not None:
        model = prepare_model_for_kbit_training(
            model, use_gradient_checkpointing=bool(hyp.get("gradient_checkpointing", True))
        )
    lora_config = LoraConfig(
        r=int(hyp.get("lora_r", 16)),
        lora_alpha=int(hyp.get("lora_alpha", 32)),
        lora_dropout=float(hyp.get("lora_dropout", 0.05)),
        target_modules=list(
            hyp.get("lora_targets")
            or ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
        ),
        bias="none",
        task_type="CAUSAL_LM",
    )
    model = get_peft_model(model, lora_config)
    trainable = sum(p.numel() for p in model.parameters() if p.requires_grad)
    total = sum(p.numel() for p in model.parameters())
    print(
        f"LoRA: {trainable / 1e6:.2f}M trainable parameters "
        f"({100 * trainable / max(total, 1):.2f}% of {total / 1e9:.2f}B)"
    )
    return model


def build_reference_model(cfg: dict[str, Any], tokenizer):
    """DPO needs a frozen reference policy.

    With LoRA/QLoRA the reference is the same weights with the adapter disabled,
    so we return ``None`` and let the trainer do that.  Full fine-tuning has no
    adapter to disable, so a second frozen copy is loaded (that costs VRAM).
    """
    if cfg["method"] in ("lora", "qlora"):
        return None
    print("DPO with full fine-tuning needs a frozen reference model: loading a second copy")
    reference = AutoModelForCausalLM.from_pretrained(
        cfg["model"]["base_model"],
        torch_dtype=torch.bfloat16,
        attn_implementation=attention_implementation(cfg),
        token=os.environ.get("HF_TOKEN"),
    )
    for parameter in reference.parameters():
        parameter.requires_grad_(False)
    reference.eval()
    return reference


